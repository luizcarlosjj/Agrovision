# ──────────────────────────────────────────────────────────────────────────────
# AgroVision ML Service — variáveis de ambiente do backend
# Configure estas variáveis no Railway (Settings → Variables).
# ──────────────────────────────────────────────────────────────────────────────

# Chave de API — deve ser igual a EXPO_PUBLIC_API_KEY no app mobile
# Gere uma string aleatória segura, ex: openssl rand -hex 32
AGROVISION_API_KEY=substitua-por-chave-secreta-forte

# Roboflow (opcional — melhora acurácia de classificação se configurado)
# Crie conta em roboflow.com, treine ou use modelo público, copie a chave.
ROBOFLOW_API_KEY=rf_sua_chave_aqui
# ID do modelo no formato: workspace/model-slug/versao  ex: luiz/soja-doencas/1
ROBOFLOW_MODEL_ID=

# Caminho do modelo Keras (Railway detecta automaticamente se não definido)
# AGROVISION_MODEL_PATH=/app/model_species.h5
