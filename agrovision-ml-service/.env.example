# ──────────────────────────────────────────────────────────────────────────────
# AgroVision Backend — variáveis de ambiente
# No Railway: Settings → Variables. Local: copie para .env e preencha.
# ──────────────────────────────────────────────────────────────────────────────

# OBRIGATÓRIO — chave compartilhada com o app mobile.
# Mínimo 16 caracteres. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
AGROVISION_API_KEY=

# OBRIGATÓRIOS — credenciais do modelo Roboflow.
# Formato do MODEL_ID: workspace/model-slug/versao  ex: luiz/milho-doencas/1
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=

# Origens permitidas no CORS, separadas por vírgula. Deixe vazio se o app mobile
# for o único cliente (React Native não usa CORS).
# Ex: https://app.agrovision.com,https://staging.agrovision.com
AGROVISION_CORS_ORIGINS=

# Tamanho máximo do upload em MB (default: 5)
AGROVISION_MAX_IMAGE_MB=5

# Opcional — caminho do modelo Keras (default: model_species.keras na raiz)
# AGROVISION_MODEL_PATH=/app/model_species.keras
