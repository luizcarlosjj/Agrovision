# ──────────────────────────────────────────────────────────────────────────────
# AgroVision — variáveis de ambiente do app mobile
# Copie este arquivo para .env.local e preencha os valores.
# .env.local NÃO deve ser commitado (está no .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# URL do backend Railway (sem barra no final)
EXPO_PUBLIC_API_URL=https://agrovision-production-bdc3.up.railway.app

# Chave de API — deve ser igual a AGROVISION_API_KEY nas variáveis do Railway
# Gere uma string aleatória segura, ex: openssl rand -hex 32
EXPO_PUBLIC_API_KEY=substitua-por-chave-secreta-forte
