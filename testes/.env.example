# Copie este arquivo para .env (nunca commitar o .env real)
#
# Onde pegar a AGROVISION_API_KEY:
#   Railway Dashboard -> seu projeto agrovision-ml-service
#   -> guia "Variables" -> copie o valor de AGROVISION_API_KEY
#
# É a mesma chave que o app mobile já usa. Nao precisa criar uma nova.

AGROVISION_API_KEY=cole_sua_chave_aqui

# URL do backend (so mude se estiver rodando localmente)
AGROVISION_API_URL=https://agrovision-production-bdc3.up.railway.app
